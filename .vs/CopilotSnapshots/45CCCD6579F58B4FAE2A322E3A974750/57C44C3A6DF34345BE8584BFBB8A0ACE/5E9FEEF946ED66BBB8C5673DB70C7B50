@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Playfair+Display:ital,wght@0,400;1,400&display=swap');

:root { color: #1b1b19; background: #f3f0eb; font-family: 'DM Sans', sans-serif; font-synthesis: none; --ink: #1b1b19; --paper: #f3f0eb; --line: #c9c5be; --muted: #6d6a64; }
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; }
a { color: inherit; text-decoration: none; }
button, input { font: inherit; }
button { color: inherit; border: 0; background: none; cursor: pointer; }
img { display: block; width: 100%; object-fit: cover; }
.site-shell { overflow: hidden; }
.site-header { align-items: center; display: grid; grid-template-columns: 1fr auto 1fr; height: 92px; padding: 0 4vw; position: relative; z-index: 5; }
.wordmark { display: inline-flex; flex-direction: column; font-size: 1.15rem; font-weight: 500; letter-spacing: .18em; line-height: .95; width: fit-content; }
.wordmark small { font-size: .42rem; letter-spacing: .4em; margin-top: 7px; text-align: center; }
.main-nav { display: flex; gap: 30px; justify-content: center; }
.main-nav a, .header-actions button { font-size: .71rem; letter-spacing: .03em; }
.main-nav a:hover, .header-actions button:hover, .text-link:hover { opacity: .55; }
.header-actions { display: flex; gap: 21px; justify-content: flex-end; }
.menu-toggle { display: none; }
.hero { color: #fff; height: min(750px, calc(100vh - 92px)); min-height: 560px; position: relative; }
.hero > img { height: 100%; object-position: center 38%; }
.hero-overlay { background: linear-gradient(90deg, rgba(19, 17, 14, .47), transparent 65%), linear-gradient(0deg, rgba(0,0,0,.2), transparent 45%); inset: 0; position: absolute; }
.hero-copy { left: 8vw; position: absolute; top: 50%; transform: translateY(-47%); }
.eyebrow { color: var(--muted); font-size: .65rem; letter-spacing: .16em; margin: 0 0 24px; text-transform: uppercase; }
.eyebrow.light { color: rgba(255,255,255,.72); }
h1, h2, h3, p { font-weight: 400; margin-top: 0; }
h1, h2 { font-family: 'Playfair Display', serif; letter-spacing: -.04em; }
h1 { font-size: clamp(4.3rem, 9vw, 8.5rem); line-height: .84; margin: 0 0 44px; }
h2 { font-size: clamp(3rem, 6vw, 6.2rem); line-height: .9; margin: 0; }
em { font-style: italic; }
.button { align-items: center; display: inline-flex; font-size: .7rem; gap: 24px; letter-spacing: .1em; padding: 15px 0; text-transform: uppercase; }
.button span, .text-link span { font-size: 1.2rem; line-height: 0; }
.button-light { border-bottom: 1px solid rgba(255,255,255,.7); }
.hero-note { bottom: 30px; font-size: .65rem; letter-spacing: .06em; line-height: 1.5; position: absolute; right: 4vw; }
.section-pad { padding: 145px 8vw; }
.intro { background: #ded9d0; }
.intro-layout { display: grid; gap: 10vw; grid-template-columns: 1.2fr 1fr; }
.intro-body { align-self: end; max-width: 330px; }
.intro-body p, .feature-copy > p:not(.eyebrow) { color: #4e4b45; font-size: .95rem; line-height: 1.65; margin: 0 0 30px; }
.text-link { border-bottom: 1px solid var(--ink); display: inline-flex; font-size: .7rem; gap: 25px; letter-spacing: .1em; padding-bottom: 9px; text-transform: uppercase; }
.section-heading { align-items: end; display: flex; justify-content: space-between; margin-bottom: 60px; }
.section-heading .eyebrow { margin-bottom: 26px; }
.section-heading .text-link { margin-bottom: 7px; }
.product-grid { display: grid; gap: 20px; grid-template-columns: repeat(3, 1fr); }
.product-image { background: #e0ddd7; height: 39vw; max-height: 560px; overflow: hidden; }
.product-image img { height: 100%; transition: transform .7s ease; }
.product-card:hover .product-image img { transform: scale(1.04); }
.product-info { align-items: start; display: flex; justify-content: space-between; padding-top: 17px; }
.product-info h3 { font-size: .78rem; margin: 0 0 7px; }
.product-info p, .product-info strong { color: var(--muted); font-size: .67rem; font-weight: 400; margin: 0; }
.feature { background: #c6b8a5; display: grid; grid-template-columns: 1fr 1fr; }
.feature-image { height: 650px; }
.feature-image img { height: 100%; object-position: center; }
.feature-copy { align-self: center; max-width: 430px; padding: 70px 8vw; }
.feature-copy h2 { margin-bottom: 36px; }
.button-dark { border-bottom: 1px solid var(--ink); margin-top: 5px; }
.newsletter { align-items: start; display: grid; grid-template-columns: 1fr 1fr; }
.newsletter h2 { grid-column: 1; }
.newsletter .eyebrow { grid-column: 1 / -1; }
.signup-form { align-self: end; border-bottom: 1px solid var(--ink); display: flex; grid-column: 2; justify-content: space-between; margin-bottom: 8px; max-width: 450px; width: 100%; }
.signup-form input { background: none; border: 0; color: var(--ink); font-size: .8rem; outline: 0; padding: 13px 0; width: 100%; }
.signup-form input::placeholder { color: var(--muted); }
.signup-form button { font-size: 1.3rem; padding: 0 4px; }
.success-message { align-self: end; font-family: 'Playfair Display', serif; font-size: 1.6rem; font-style: italic; grid-column: 2; margin: 0 0 16px; }
.site-footer { background: #1b1b19; color: #f3f0eb; display: grid; gap: 35px 8vw; grid-template-columns: 2fr 1fr 1fr; padding: 75px 8vw 28px; }
.site-footer .wordmark { color: #f3f0eb; }
.footer-brand p { color: #a6a39d; font-size: .7rem; line-height: 1.5; margin: 38px 0 0; }
.footer-column { display: flex; flex-direction: column; gap: 12px; }
.footer-column .eyebrow { color: #8c8982; margin: 0 0 12px; }
.footer-column a { font-size: .72rem; }
.footer-bottom { border-top: 1px solid #41403c; color: #8c8982; display: flex; font-size: .62rem; grid-column: 1 / -1; justify-content: space-between; margin-top: 50px; padding-top: 18px; }
.sr-only { height: 1px; margin: -1px; overflow: hidden; position: absolute; width: 1px; clip: rect(0, 0, 0, 0); }

@media (max-width: 700px) {
  .site-header { grid-template-columns: 1fr auto; height: 78px; padding: 0 6vw; }
  .wordmark { font-size: 1rem; }
  .menu-toggle { align-items: center; display: flex; font-size: .7rem; gap: 10px; letter-spacing: .08em; text-transform: uppercase; }
  .menu-toggle i { background: var(--ink); display: block; height: 1px; position: relative; width: 18px; }
  .menu-toggle i::after { background: var(--ink); content: ''; height: 1px; position: absolute; right: 0; top: 5px; width: 12px; }
  .main-nav { background: var(--paper); display: none; flex-direction: column; gap: 22px; left: 0; padding: 25px 6vw 30px; position: absolute; right: 0; top: 78px; }
  .main-nav.is-open { display: flex; }
  .header-actions { display: none; }
  .hero { height: 76vh; min-height: 520px; }
  .hero > img { object-position: 62% center; }
  .hero-copy { left: 8vw; top: 53%; }
  h1 { font-size: clamp(4rem, 19vw, 6.3rem); }
  .hero-note { bottom: 25px; left: 8vw; right: auto; }
  .section-pad { padding: 88px 7vw; }
  .intro-layout, .newsletter { display: block; }
  .intro h2 { margin-bottom: 58px; }
  .section-heading { align-items: start; display: block; margin-bottom: 38px; }
  .section-heading .text-link { margin-top: 28px; }
  .product-grid { gap: 45px; grid-template-columns: 1fr; }
  .product-image { height: 115vw; max-height: none; }
  .feature { display: flex; flex-direction: column; }
  .feature-image { height: 105vw; }
  .feature-copy { padding: 76px 7vw 90px; }
  .newsletter h2 { margin-bottom: 56px; }
  .signup-form { max-width: none; }
  .site-footer { grid-template-columns: 1fr 1fr; padding: 65px 7vw 25px; }
  .footer-brand { grid-column: 1 / -1; margin-bottom: 28px; }
  .footer-bottom { margin-top: 35px; }
}
